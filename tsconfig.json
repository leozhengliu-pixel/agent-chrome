{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "bridge/**/*.ts",
    "host/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "extension/policy.js"
  ]
}
